rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Regra padrão: bloquear tudo ──
    match /{document=**} {
      allow read, write: if false;
    }

    // ── Coleção vip-signups ──
    match /vip-signups/{docId} {
      // Waitlist now uses FastAPI/PostgreSQL. Admin SDK can export legacy entries.
      allow read, write: if false;
    }
  }
}
