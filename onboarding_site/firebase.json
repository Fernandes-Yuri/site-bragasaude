{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/app/**",
        "destination": "/app-download.html"
      },
      {
        "source": "/privacidade",
        "destination": "/privacidade.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacidade.html"
      },
      {
        "source": "/termos",
        "destination": "/termos.html"
      },
      {
        "source": "/terms",
        "destination": "/termos.html"
      },
      {
        "source": "/exclusao-de-dados",
        "destination": "/exclusao-de-dados.html"
      },
      {
        "source": "/excluir-conta",
        "destination": "/exclusao-de-dados.html"
      },
      {
        "source": "/data-deletion",
        "destination": "/exclusao-de-dados.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/downloads/**/*.apk",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Content-Disposition",
            "value": "attachment"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/js/release-metadata.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/js/main.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/exclusao-de-dados{,/**,.html}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/app",
        "destination": "/app-download.html",
        "type": 302
      }
    ],
    "site": "braga-saude"
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
